# "mock" runs the UI on built-in sample data. "live" calls the FastAPI backend via /api/v1.
NEXT_PUBLIC_API_MODE=mock
# FastAPI base URL; Next.js proxies /api/v1/* to it (only used when NEXT_PUBLIC_API_MODE=live).
API_URL=http://localhost:8000
# Backend (local development). Copy this file to .env and fill in values; .env is never committed.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
REDIS_HOST=
REDIS_PORT=
